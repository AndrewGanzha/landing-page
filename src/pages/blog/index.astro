---
import Layout from "../../layouts/Layout.astro";
import CatLogo from "../../components/CatLogo.astro";

const placeholders = [1, 2, 3];
---

<Layout title="Blog — HELL WORLD" description="Notes on backend engineering, Python, and FastAPI.">
  <section class="blog">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h1 class="blog__title">Blog</h1>
      <p class="blog__intro">Notes on backend engineering, Python, and FastAPI. Nothing published yet.</p>

      <div class="grid">
        {
          placeholders.map(() => (
            <article class="card card--placeholder">
              <CatLogo class="card__mark" />
              <h2 class="card__title">Coming soon</h2>
              <p class="card__text">New articles are brewing. Check back soon.</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog {
    padding: 64px 0 96px;
  }

  .blog__title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 6px 0 14px;
  }

  .blog__intro {
    max-width: 56ch;
    color: var(--color-text-dim);
    font-size: 0.95rem;
    margin-bottom: 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .card {
    position: relative;
    padding: 28px;
    border-radius: 4px;
    overflow: hidden;
  }

  .card--placeholder {
    border: 1px dashed var(--color-line);
    background: var(--color-bg-elevated);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  :global(.card__mark) {
    width: 26px;
    height: 26px;
    color: var(--color-gray);
    margin-bottom: 4px;
  }

  .card__title {
    font-size: 1.1rem;
    color: var(--color-text-dim);
  }

  .card__text {
    font-size: 0.85rem;
    color: var(--color-text-dim);
    opacity: 0.75;
  }
</style>
